{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "python",
      "last-release-sha": "1221ae6acbe4a0398fb5f3e51db4fc670395b0e1",
      "pull-request-header": "## Release summary",
      "pull-request-footer": "## Verification\n\nRequired checks must pass before merge.",
      "include-component-in-tag": false,
      "draft": true,
      "force-tag-creation": true,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "extra-files": [
        "plugins/agent-parley/.claude-plugin/plugin.json",
        "plugins/agent-parley/.codex-plugin/plugin.json",
        {
          "type": "json",
          "path": ".claude-plugin/marketplace.json",
          "jsonpath": "$.plugins[0].version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='agent-parley')].version"
        }
      ],
      "changelog-sections": [
        {"type": "feat", "section": "Features"},
        {"type": "fix", "section": "Bug fixes"},
        {"type": "perf", "section": "Performance"},
        {"type": "docs", "section": "Documentation", "hidden": true},
        {"type": "revert", "section": "Reverts"},
        {"type": "chore", "section": "Maintenance", "hidden": true},
        {"type": "ci", "section": "Automation", "hidden": true},
        {"type": "build", "section": "Build", "hidden": true},
        {"type": "refactor", "section": "Refactoring", "hidden": true},
        {"type": "test", "section": "Tests", "hidden": true}
      ]
    }
  }
}
